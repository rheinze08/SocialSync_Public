<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site_title | default("SocialSync") }}</title>
    <meta name="description" content="{{ site_description | default("Automated content generation and posting across social media.") }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --ink: #1b1f2a;
        --muted: #566277;
        --surface: #ffffff;
        --accent: #1f7a6b;
        --accent-dark: #145548;
        --accent-soft: #e5f3ef;
        --spotlight: #1d4ed8;
        --spotlight-soft: rgba(29, 78, 216, 0.12);
        --border: rgba(27, 31, 42, 0.12);
        --bg-1: #f4f6f2;
        --bg-2: #dae6f2;
        --bg-3: #f7e0c8;
        --shadow: 0 24px 60px rgba(17, 24, 39, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", sans-serif;
        color: var(--ink);
        background: radial-gradient(circle at 10% 10%, var(--bg-3), transparent 60%),
          radial-gradient(circle at 85% 15%, var(--bg-2), transparent 55%),
          linear-gradient(145deg, var(--bg-1), #ffffff 60%);
        min-height: 100vh;
      }

      body::before,
      body::after {
        content: "";
        position: fixed;
        z-index: -1;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        filter: blur(36px);
        opacity: 0.35;
      }

      body::before {
        top: 12%;
        left: -140px;
        background: #f4c9a9;
      }

      body::after {
        bottom: -90px;
        right: -120px;
        background: #c2d8f0;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 48px 24px 72px;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 16px;
        padding-bottom: 28px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 600;
      }

      .logo-mark {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        background: var(--accent);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-family: "Fraunces", serif;
        box-shadow: 0 16px 26px rgba(31, 122, 107, 0.3);
      }

      .logo-title {
        font-size: 1.05rem;
        letter-spacing: 0.02em;
      }

      .logo-sub {
        font-size: 0.9rem;
        color: var(--muted);
      }

      .logo-credit {
        font-size: 0.85rem;
        color: var(--muted);
      }

      .hero {
        display: grid;
        gap: 18px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-size: 0.85rem;
        font-weight: 600;
        width: fit-content;
      }

      h1 {
        font-family: "Fraunces", serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        line-height: 1.05;
        margin: 0;
      }

      p.lead {
        font-size: 1.1rem;
        color: var(--muted);
        line-height: 1.7;
        margin: 0;
        max-width: 820px;
      }

      .hero-images {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 18px;
        margin-top: 10px;
      }

      figure {
        margin: 0;
      }

      .image-card {
        background: var(--surface);
        border-radius: 20px;
        padding: 12px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        display: grid;
        gap: 10px;
      }

      .image-card img {
        border-radius: 14px;
      }

      .image-card figcaption {
        font-size: 0.9rem;
        color: var(--muted);
      }

      .section {
        margin-top: 64px;
      }

      .section h2 {
        font-family: "Fraunces", serif;
        font-size: clamp(2rem, 3vw, 2.6rem);
        margin-bottom: 12px;
      }

      .section p {
        color: var(--muted);
        line-height: 1.7;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 18px;
        margin-top: 22px;
      }

      .card {
        background: var(--surface);
        border-radius: 20px;
        padding: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 18px 40px rgba(27, 31, 42, 0.1);
      }

      .card h3 {
        margin: 0 0 8px;
        font-size: 1.05rem;
      }

      .card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .split {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: 28px;
        align-items: center;
      }

      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
      }

      .list {
        list-style: none;
        padding: 0;
        margin: 16px 0 0;
        display: grid;
        gap: 10px;
      }

      .list li {
        position: relative;
        padding-left: 20px;
        color: var(--muted);
        line-height: 1.6;
      }

      .list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }

      .footer {
        margin-top: 72px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
      }

      .cta-card {
        background: var(--surface);
        border-radius: 22px;
        padding: 22px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .cta-card a {
        color: var(--accent-dark);
        font-weight: 600;
      }

      .highlight-callout {
        background: linear-gradient(120deg, var(--spotlight-soft), rgba(29, 78, 216, 0.03));
        border: 1px solid rgba(29, 78, 216, 0.2);
        border-left: 6px solid var(--spotlight);
        border-radius: 22px;
        padding: 18px 22px;
        box-shadow: var(--shadow);
      }

      .highlight-text {
        margin: 0;
        font-size: clamp(1.2rem, 2.2vw, 1.6rem);
        font-weight: 600;
        color: var(--spotlight);
        line-height: 1.4;
      }

      .reveal {
        opacity: 0;
        transform: translateY(12px);
        animation: fadeUp 700ms ease forwards;
        animation-delay: var(--delay, 0ms);
      }

      .zoomable {
        cursor: zoom-in;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(15, 20, 30, 0.82);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease;
        z-index: 5;
        padding: 20px;
      }

      .lightbox.open {
        opacity: 1;
        pointer-events: auto;
      }

      .lightbox img {
        max-width: min(92vw, 1100px);
        max-height: 85vh;
        border-radius: 18px;
        background: #fff;
        padding: 8px;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
      }

      @keyframes fadeUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 900px) {
        .split {
          grid-template-columns: 1fr;
        }

        header {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="reveal" style="--delay: 60ms;">
        <div class="logo">
          <div class="logo-mark">{{ logo_letter | default("S") }}</div>
          <div>
            <div class="logo-title">{{ project_name | default("SocialSync") }}</div>
            <div class="logo-sub">{{ project_tagline | default("AI-driven social content orchestration and automation to promote your small business.") }}</div>
            <div class="logo-credit">{{ project_credit | default("Developed by DataWiseGuys, LLC.") }}</div>
          </div>
        </div>
      </header>

      <section class="hero reveal" style="--delay: 120ms;">
        <div class="eyebrow">{{ hero_label | default("One-page overview") }}</div>
        <h1>{{ hero_title | default("Automate your company's content generation and posting across social media.") }}</h1>
        <p class="lead">
          {{ hero_subtitle | default("SocialSync makes it simple to post various types of content to Facebook, Instagram, and X on a pre-determined schedule. Content can be manually generated by your team or produced by AI platforms like OpenAI and Gemini, with workflows that keep context flowing from step to step.") }}
        </p>
        <div class="highlight-callout reveal" style="--delay: 180ms;">
          <p class="highlight-text">And the best part? It's easy to set up and designed to reduce costs.</p>
        </div>
        <div class="hero-images">
          <figure class="image-card">
            <img class="zoomable" src="pages/ai_image_to_ai_post_1.png" alt="AI image to AI post pipeline preview.">
            <figcaption>AI image to AI post with context-aware copy.</figcaption>
          </figure>
          <figure class="image-card">
            <img class="zoomable" src="pages/random_image_to_ai_post_1.png" alt="Random image to AI post preview.">
            <figcaption>Randomized or manual image selection with AI-generated posts.</figcaption>
          </figure>
        </div>
      </section>

      <section class="section">
        <div class="reveal" style="--delay: 160ms;">
          <h2>Flexible Content Workflows</h2>
          <p>
            Workflows are easy to build and pass context downstream, so every AI output aligns with images and instructions from previous steps.
          </p>
        </div>
        <div class="cards">
          <article class="card reveal" style="--delay: 200ms;">
            <h3>Manual Images + Posts</h3>
            <p>Bring your own assets and captions when you already have everything prepared.</p>
          </article>
          <article class="card reveal" style="--delay: 240ms;">
            <h3>Manual Images + AI Posts</h3>
            <p>Add image descriptions to help AI write posts. Optionally, let SocialSync select images randomly from a pool of candidates to rotate content.</p>
          </article>
          <article class="card reveal" style="--delay: 280ms;">
            <h3>AI Images + AI Posts</h3>
            <p>
              Generate images from instructions or juxtaposed options (e.g., "the dog wears a hat/tie with an ocean/mountain
              in the background"), then let AI craft the post using the selected image context.
            </p>
          </article>
          <article class="card reveal" style="--delay: 320ms;">
            <h3>Video Forthcoming</h3>
            <p>Video integration is forthcoming using Sora and other AI tools.</p>
          </article>
        </div>
      </section>

      <section class="section split">
        <div class="reveal" style="--delay: 180ms;">
          <h2>Instruction-Driven Pipelines</h2>
          <p>
            Instructions flow through each step so OpenAI, Gemini, or any other model understands the intent,
            constraints, and context.
          </p>
          <ul class="list">
            <li>Build detailed instructions once and reuse them across multiple templates or runs.</li>
            <li>Pair Image and Post instructions to flow in either direction depending on your needs.</li>
            <li>Leverage cutting-edge models from multiple AI companies to find the best fit to your content style.</li>
          </ul>
        </div>
        <div class="gallery reveal" style="--delay: 240ms;">
          <figure class="image-card">
            <img class="zoomable" src="pages/ai_image_instructions_example_1.png" alt="AI image instruction example.">
            <figcaption>AI image instruction example.</figcaption>
          </figure>
          <figure class="image-card">
            <img class="zoomable" src="pages/ai_post_instructions_example_1.png" alt="AI post instruction example.">
            <figcaption>AI post instruction example.</figcaption>
          </figure>
        </div>
      </section>

      <section class="section split">
        <div class="reveal" style="--delay: 200ms;">
          <h2>Built for Content Management</h2>
          <p>The UI is intentionally simple so content, credentials, and instructions stay organized.</p>
          <ul class="list">
            <li>Profiles map to social credentials, image stores, and instruction stores.</li>
            <li>Use templates to easily visualize workflows.</li>
            <li>
              If desired, provide a set of options for content features and let SocialSync cycle through them
              to always keep your posts fresh.
            </li>
          </ul>
        </div>
        <div class="gallery reveal" style="--delay: 260ms;">
          <figure class="image-card">
            <img class="zoomable" src="pages/base_ui.png" alt="SocialSync base UI.">
            <figcaption>Core UI layout for profiles and workflows.</figcaption>
          </figure>
          <figure class="image-card">
            <img class="zoomable" src="pages/ai_image_to_ai_post_template_example_1.png" alt="AI image to AI post template example.">
            <figcaption>Template that binds image and post steps.</figcaption>
          </figure>
        </div>
      </section>

      <section class="section">
        <div class="cta-card reveal" style="--delay: 220ms;">
          <h2>Interested in getting started?</h2>
          <p>
            Reach out at
            <a href="mailto:datawiseguysllc@gmail.com">datawiseguysllc@gmail.com</a>
            to talk through your workflow and launch plan.
          </p>
        </div>
      </section>

      <footer class="footer reveal" style="--delay: 240ms;">
        <div>{{ footer_left | default("SocialSync makes it easy to promote your small business on social media.") }}</div>
        <div class="footer-time">
          Last updated: <span class="build-time" data-build-time="{{ build_time | default('') }}"></span>
        </div>
      </footer>
    </div>

    <div class="lightbox" aria-hidden="true">
      <img src="" alt="">
    </div>
    <script>
      const lightbox = document.querySelector(".lightbox");
      const lightboxImg = lightbox.querySelector("img");
      const zoomables = document.querySelectorAll(".zoomable");

      const closeLightbox = () => {
        lightbox.classList.remove("open");
        lightbox.setAttribute("aria-hidden", "true");
      };

      zoomables.forEach((img) => {
        img.addEventListener("click", () => {
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.classList.add("open");
          lightbox.setAttribute("aria-hidden", "false");
        });
      });

      lightbox.addEventListener("click", closeLightbox);
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeLightbox();
        }
      });

      const buildTimeEl = document.querySelector(".build-time");
      if (buildTimeEl) {
        const rawBuildTime = buildTimeEl.getAttribute("data-build-time") || "";
        const cleanedBuildTime = rawBuildTime.includes("{") ? "" : rawBuildTime.trim();
        buildTimeEl.textContent = cleanedBuildTime || new Date().toISOString().slice(0, 10);
      }
    </script>
  </body>
</html>
