<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site_title | default("SocialSync") }}</title>
    <meta name="description" content="{{ site_description | default("SocialSync keeps your social content organized, on-brand, and ready to ship.") }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --ink: #1b1f2a;
        --muted: #5b677a;
        --surface: #ffffff;
        --accent: #e35b2c;
        --accent-dark: #b13f1b;
        --accent-soft: #ffe3d6;
        --border: rgba(27, 31, 42, 0.12);
        --bg-1: #f7f2e8;
        --bg-2: #dfe9f3;
        --bg-3: #f6d6c6;
        --shadow: 0 30px 80px rgba(27, 31, 42, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", sans-serif;
        color: var(--ink);
        background: radial-gradient(circle at top left, var(--bg-3), transparent 55%),
          radial-gradient(circle at 70% 20%, var(--bg-2), transparent 50%),
          linear-gradient(135deg, var(--bg-1), #ffffff 55%);
        min-height: 100vh;
      }

      body::before,
      body::after {
        content: "";
        position: fixed;
        z-index: -1;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        filter: blur(40px);
        opacity: 0.4;
      }

      body::before {
        top: 10%;
        left: -120px;
        background: #ffd2b6;
      }

      body::after {
        bottom: -80px;
        right: -120px;
        background: #c8e1f2;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 48px 24px 80px;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 32px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .logo-mark {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: var(--accent);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-family: "Fraunces", serif;
        box-shadow: 0 14px 24px rgba(227, 91, 44, 0.35);
      }

      nav {
        display: flex;
        gap: 18px;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 48px;
        align-items: center;
        margin-top: 24px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-size: 0.85rem;
        font-weight: 600;
      }

      h1 {
        font-family: "Fraunces", serif;
        font-size: clamp(2.6rem, 3.8vw, 4rem);
        line-height: 1.05;
        margin: 18px 0 16px;
      }

      p.lead {
        font-size: 1.1rem;
        color: var(--muted);
        line-height: 1.65;
        margin: 0 0 26px;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .btn {
        padding: 12px 20px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 600;
        transition: transform 150ms ease, box-shadow 150ms ease;
      }

      .btn.primary {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 18px 30px rgba(227, 91, 44, 0.25);
      }

      .btn.secondary {
        background: var(--surface);
        border-color: var(--border);
        color: var(--ink);
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .hero-card {
        background: var(--surface);
        border-radius: 28px;
        padding: 28px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
      }

      .hero-card h3 {
        margin: 0 0 18px;
        font-size: 1.1rem;
      }

      .hero-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 14px;
      }

      .hero-card li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
        margin-top: 6px;
        flex: 0 0 auto;
      }

      .section {
        margin-top: 80px;
      }

      .section h2 {
        font-family: "Fraunces", serif;
        font-size: clamp(2rem, 3vw, 2.6rem);
        margin-bottom: 12px;
      }

      .section p {
        color: var(--muted);
        line-height: 1.7;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-top: 28px;
      }

      .tile {
        background: var(--surface);
        border-radius: 22px;
        padding: 22px;
        border: 1px solid var(--border);
        box-shadow: 0 12px 30px rgba(27, 31, 42, 0.08);
      }

      .tile h4 {
        margin: 0 0 8px;
        font-size: 1.05rem;
      }

      .tile p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .split {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 28px;
        margin-top: 24px;
      }

      .steps {
        display: grid;
        gap: 16px;
      }

      .step {
        display: flex;
        gap: 16px;
        padding: 14px 18px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--border);
      }

      .step strong {
        font-size: 0.95rem;
        min-width: 80px;
        color: var(--accent-dark);
      }

      .release-card {
        background: var(--ink);
        color: #fff;
        border-radius: 26px;
        padding: 26px;
        display: grid;
        gap: 14px;
      }

      .release-card a {
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        width: fit-content;
      }

      footer {
        margin-top: 90px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
      }

      .reveal {
        opacity: 0;
        transform: translateY(14px);
        animation: fadeUp 700ms ease forwards;
        animation-delay: var(--delay, 0ms);
      }

      @keyframes fadeUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 900px) {
        header {
          flex-direction: column;
          align-items: flex-start;
        }

        nav {
          flex-wrap: wrap;
        }

        .hero {
          grid-template-columns: 1fr;
        }

        .cta-row {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="reveal" style="--delay: 60ms;">
        <div class="logo">
          <div class="logo-mark">{{ logo_letter | default("S") }}</div>
          <div>{{ project_name | default("SocialSync") }}</div>
        </div>
        <nav>
          <a href="{{ docs_url | default('#features') }}">Features</a>
          <a href="{{ repo_url | default('#workflow') }}">Workflow</a>
          <a href="{{ changelog_url | default('#release') }}">Releases</a>
          <a href="{{ contact_url | default('#cta') }}">Contact</a>
        </nav>
      </header>

      <section class="hero">
        <div class="reveal" style="--delay: 120ms;">
          <div class="eyebrow">{{ hero_label | default("Launch-ready social ops") }}</div>
          <h1>{{ hero_title | default("Plan, generate, and ship social content without losing your voice.") }}</h1>
          <p class="lead">
            {{ hero_subtitle | default("SocialSync blends AI-assisted ideation with structured workflows so your team can build, review, and publish content faster while staying on-brand.") }}
          </p>
          <div class="cta-row">
            <a class="btn primary" href="{{ download_url | default('#cta') }}">Download the latest build</a>
            <a class="btn secondary" href="{{ demo_url | default('#workflow') }}">See the workflow</a>
          </div>
        </div>
        <div class="hero-card reveal" style="--delay: 200ms;">
          <h3>Why teams keep SocialSync open all day</h3>
          <ul>
            {% for item in hero_bullets | default([]) %}
            <li><span class="dot"></span>{{ item }}</li>
            {% else %}
            <li><span class="dot"></span>Instantly align tone, channel, and campaign goals.</li>
            <li><span class="dot"></span>Batch-generate visuals and copy from one brief.</li>
            <li><span class="dot"></span>Track approvals without chasing updates.</li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <section id="features" class="section">
        <div class="reveal" style="--delay: 100ms;">
          <h2>{{ features_title | default("Everything you need to ship reliably") }}</h2>
          <p>{{ features_subtitle | default("Keep strategy, production, and delivery tied together. SocialSync keeps the queue moving, even when the schedule changes.") }}</p>
        </div>
        <div class="grid">
          {% for feature in features | default([]) %}
          <div class="tile reveal" style="--delay: {{ 140 + loop.index0 * 60 }}ms;">
            <h4>{{ feature.title }}</h4>
            <p>{{ feature.body }}</p>
          </div>
          {% else %}
          <div class="tile reveal" style="--delay: 140ms;">
            <h4>Content boards with intent</h4>
            <p>Organize campaigns, channels, and formats in one shared command center.</p>
          </div>
          <div class="tile reveal" style="--delay: 200ms;">
            <h4>AI generation you can steer</h4>
            <p>Iterate on prompts, lock brand language, and review outputs in one flow.</p>
          </div>
          <div class="tile reveal" style="--delay: 260ms;">
            <h4>Release ready assets</h4>
            <p>Export final captions, images, and schedules without scrambling.</p>
          </div>
          {% endfor %}
        </div>
      </section>

      <section id="workflow" class="section split">
        <div class="reveal" style="--delay: 120ms;">
          <h2>{{ workflow_title | default("A workflow that respects momentum") }}</h2>
          <p>{{ workflow_subtitle | default("From the first brief to the final asset, SocialSync keeps context attached to every decision.") }}</p>
          <div class="steps">
            {% for step in workflow_steps | default([]) %}
            <div class="step">
              <strong>{{ step.label }}</strong>
              <span>{{ step.body }}</span>
            </div>
            {% else %}
            <div class="step">
              <strong>Brief</strong>
              <span>Capture audience, tone, and campaign intent in a single prompt.</span>
            </div>
            <div class="step">
              <strong>Build</strong>
              <span>Generate visuals, captions, and variants with AI + human direction.</span>
            </div>
            <div class="step">
              <strong>Ship</strong>
              <span>Approve, export, and schedule content without email chains.</span>
            </div>
            {% endfor %}
          </div>
        </div>
        <div id="release" class="release-card reveal" style="--delay: 200ms;">
          <h3>{{ release_title | default("Latest release") }}</h3>
          <div>{{ release_name | default("SocialSync Desktop") }}</div>
          <div>Version: {{ release_version | default("v0.0.0") }}</div>
          <div>Published: {{ release_date | default("TBD") }}</div>
          <a href="{{ release_url | default('#cta') }}">View release notes</a>
        </div>
      </section>

      <section id="cta" class="section">
        <div class="reveal" style="--delay: 140ms;">
          <h2>{{ cta_title | default("Put SocialSync to work") }}</h2>
          <p>{{ cta_subtitle | default("Ready to build a release cadence your team can trust? Start with the latest build or check the docs for setup details.") }}</p>
        </div>
        <div class="cta-row reveal" style="--delay: 200ms;">
          <a class="btn primary" href="{{ download_url | default('#') }}">Get the build</a>
          <a class="btn secondary" href="{{ setup_url | default('#') }}">Setup guide</a>
          <a class="btn secondary" href="{{ repo_url | default('#') }}">GitHub repository</a>
        </div>
      </section>

      <footer>
        <div>{{ footer_left | default("Built for teams who move fast and stay on brand.") }}</div>
        <div>{{ footer_right | default("Last updated: " ~ build_time) }}</div>
      </footer>
    </div>
  </body>
</html>
